# ResponseOS — environment variable template.
# This file is checked into the repo. NEVER put real secrets here.
# Copy to `.env.local` (which is gitignored) and fill in real values for local dev.
# All providers are wired through mock adapters until the corresponding keys are present.

# --- App ---
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# --- Database (Postgres — Neon default per ADR-0026) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth (Clerk) ---
# Per ADR-0005 + v0.2 closeout step 2.4. Setting CLERK_SECRET_KEY activates the
# Clerk session-derivation path in lib/auth/session.ts (32B) AND proxy.ts route
# protection (32C). When CLERK_SECRET_KEY is absent the app boots and runs on
# the placeholder dev-session per ADR-0001 (mock-first) and proxy.ts is a
# pass-through.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Signs /api/webhooks/clerk per ADR-0009 (Svix HMAC). When absent the webhook
# handler fails closed (503) and performs no mutation.
CLERK_WEBHOOK_SECRET=
# Identifies the AJ Digital cross-tenant Clerk organization. Members
# of this org map to Session.account = null (aj_admin / operator
# cross-tenant access). Consumed by 32B.
AJ_DIGITAL_CLERK_ORG_ID=

# --- Dev session override (LOCAL / TEST / DEV ONLY) ---
# OPTIONAL. Forces lib/auth/session.ts to resolve a fixed placeholder session,
# bypassing Clerk — for local development and tests only.
# MUST NOT be set in production: lib/auth/session.ts throws
# DevSessionInProductionError when this is set under NODE_ENV=production.
# When unset (and CLERK_SECRET_KEY also unset) the session falls back to the
# default placeholder (aj_admin) per ADR-0001 (mock-first) — local boot needs no value.
# Supported values: aj_admin | operator | client_admin@org_mock_1 | client_viewer@org_mock_1
RESPONSEOS_DEV_SESSION=

# --- Provider credential encryption (ADR-0020) ---
# SERVER-ONLY AES-256-GCM key used to encrypt stored provider credentials.
# Format: base64-encoded 32 bytes. NEVER prefix with NEXT_PUBLIC_.
# REQUIRED only when live encrypted provider credentials are used (v0.3+).
# OPTIONAL for local mock-first dev: when absent/empty/not-32-bytes, the
# encryption module (lib/providers/encryption) stays in MOCK MODE — a redacted
# sentinel is stored and deterministic mock credentials are returned (ADR-0020 §6).
RESPONSEOS_PROVIDER_KEY=

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AI Voice ---
RETELL_API_KEY=
VAPI_API_KEY=
BLAND_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Workflows (n8n) ---
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=

# --- CRM ---
GHL_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Professional knowledge / Career OS boundary (ADR-0046) ---
# Probed by lib/providers/professionalKnowledge and
# lib/providers/professionalHandoff. No live factory is wired, so both
# adapters stay mock/no-op even when these are set — they exist so the
# variable names are declared rather than discovered later.
CAREER_OS_API_KEY=
CAREER_OS_WEBHOOK_URL=

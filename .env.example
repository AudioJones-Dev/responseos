# ResponseOS — environment variable template.
# This file is checked into the repo. NEVER put real secrets here.
# Copy to `.env.local` (which is gitignored) and fill in real values for local dev.
# All providers are wired through mock adapters until the corresponding keys are present.

# --- App ---
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# --- Database (Postgres / Supabase) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth (Clerk) ---
# Per ADR-0005 + v0.2 closeout step 2.4. Setting CLERK_SECRET_KEY activates the
# Clerk session-derivation path in lib/auth/session.ts (32B) AND proxy.ts route
# protection (32C). When CLERK_SECRET_KEY is absent the app boots and runs on
# the placeholder dev-session per ADR-0001 (mock-first) and proxy.ts is a
# pass-through.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Signs /api/webhooks/clerk per ADR-0009 (Svix HMAC). When absent the webhook
# handler fails closed (503) and performs no mutation.
CLERK_WEBHOOK_SECRET=
# Identifies the AJ Digital cross-tenant Clerk organization. Members
# of this org map to Session.account = null (aj_admin / operator
# cross-tenant access). Consumed by 32B.
AJ_DIGITAL_CLERK_ORG_ID=

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AI Voice ---
RETELL_API_KEY=
VAPI_API_KEY=
BLAND_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Workflows (n8n) ---
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=

# --- CRM ---
GHL_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

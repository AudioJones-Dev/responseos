// ResponseOS — schema for v0.2.
// v0.1 baseline: 11 TypeScript models in /types mirrored as Prisma models.
// v0.2 delta: adds 4 new models (AssessmentReport, Engagement, AuditLog, WebhookEvent)
// + 4 new enum families per docs/v0.2-implementation-spec.md §2.
// Existing v0.1 models and enums are preserved unchanged.
//
// Conventions:
// - snake_case columns to match the API/JSON shapes already used by the app.
// - Tenant isolation: every per-tenant table carries account_id.
// - Money is stored in cents (Int).
// - JSON fields use the database Json type so config payloads stay flexible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Use DIRECT_URL when running migrations through a non-pooled connection.
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  lead
  active
  paused
  cancelled
}

// Administrative classification of a tenant (ADR-0046). `internal_demo`
// is the ResponseOS dogfooding / demonstration lane: it changes
// reporting and console labelling only — never tenant isolation, auth,
// audit, provider resolution, or any other runtime behaviour.
enum AccountType {
  customer
  internal
  internal_demo
  sandbox
}

enum UserRole {
  aj_admin
  operator
  client_admin
  client_viewer
}

enum ContactSource {
  call
  sms
  form
  manual
  crm_sync
}

enum CallProvider {
  twilio
  retell
  vapi
  bland
  manual
  telnyx
}

enum CallDirection {
  inbound
  outbound
}

enum CallStatus {
  answered
  missed
  voicemail
  spam
  failed
  completed
}

enum CallSentiment {
  positive
  neutral
  negative
}

enum LeadEventSource {
  phone
  sms
  website
  manual
  outbound
}

enum LeadEventType {
  missed_call
  answered_call
  quote_request
  booking_request
  qualified_lead
  spam
  follow_up_needed
  appointment_booked
  quote_sent
  job_won
  job_lost
}

enum LeadEventStatus {
  new
  qualified
  unqualified
  booked
  quoted
  won
  lost
  archived
}

enum LeadUrgency {
  low
  medium
  high
}

enum QualificationTimeline {
  same_day
  this_week
  this_month
  unknown
}

enum QualificationStatus {
  qualified
  maybe
  unqualified
  spam
}

enum CalendarProvider {
  google
  calcom
  ghl
  manual
  calendly
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum QuoteStatus {
  requested
  reviewing
  sent
  accepted
  declined
}

enum AutomationTriggerType {
  missed_call
  after_hours_call
  new_lead
  quote_requested
  booking_created
  no_response
  job_completed
}

enum AutomationStatus {
  active
  paused
  draft
}

enum WorkflowProvider {
  n8n
  make
  internal
}

enum NotificationChannel {
  sms
  email
  in_app
  slack
}

enum NotificationStatus {
  queued
  sent
  failed
}

model Account {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  industry      String
  website_url   String?
  primary_phone String?
  timezone      String
  status        AccountStatus @default(lead)
  // ADR-0046 — administrative classification. Defaults to `customer`
  // so every existing row stays valid without backfill.
  account_type  AccountType   @default(customer)
  // 32A — Clerk integration substrate per ADR-0005 + step-2.4 plan §4.3.
  // Nullable so existing seeded accounts stay valid without backfill.
  // Wiring (session derivation, webhook sync) lands in 32B/32C.
  clerk_org_id  String?       @unique
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
}

model User {
  id            String   @id @default(cuid())
  account_id    String?
  role          UserRole
  name          String
  email         String   @unique
  phone         String?
  // 32A — Clerk integration substrate per ADR-0005 + step-2.4 plan §4.2.
  // Nullable so existing seeded users stay valid without backfill.
  // Wiring (session derivation, webhook sync, JIT provisioning) lands
  // in 32B/32C.
  clerk_user_id String?  @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([account_id])
}

model Contact {
  id             String        @id @default(cuid())
  account_id     String
  first_name     String?
  last_name      String?
  phone          String?
  email          String?
  email_verified Boolean       @default(false)
  address        String?
  city           String?
  state          String?
  zip            String?
  source         ContactSource
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  @@index([account_id])
  @@index([phone])
  @@index([email])
}

model Call {
  id               String         @id @default(cuid())
  account_id       String
  contact_id       String?
  provider         CallProvider
  provider_call_id String?
  direction        CallDirection
  status           CallStatus
  from_number      String
  to_number        String
  started_at       DateTime
  ended_at         DateTime?
  duration_seconds Int?
  recording_url    String?
  transcript       String?
  summary          String?
  sentiment        CallSentiment?
  spam_score       Float?
  lead_score       Int?
  created_at       DateTime       @default(now())

  @@unique([account_id, provider, provider_call_id])
  @@index([account_id])
  @@index([contact_id])
  @@index([started_at])
}

model LeadEvent {
  id              String          @id @default(cuid())
  account_id      String
  contact_id      String?
  call_id         String?
  source          LeadEventSource
  event_type      LeadEventType
  status          LeadEventStatus @default(new)
  urgency         LeadUrgency     @default(medium)
  estimated_value Int?
  recovered_value Int?
  notes           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  @@index([account_id])
  @@index([contact_id])
  @@index([call_id])
  @@index([status])
}

model LeadQualification {
  id                      String                 @id @default(cuid())
  lead_event_id           String                 @unique
  service_needed          String?
  service_area_match      Boolean
  budget_range            String?
  timeline                QualificationTimeline?
  property_type           String?
  decision_maker          Boolean?
  qualification_score     Int
  qualification_status    QualificationStatus
  disqualification_reason String?
  created_at              DateTime               @default(now())
}

model Appointment {
  id                String            @id @default(cuid())
  account_id        String
  contact_id        String
  lead_event_id     String?
  calendar_provider CalendarProvider
  external_event_id String?
  title             String
  start_time        DateTime
  end_time          DateTime
  status            AppointmentStatus @default(scheduled)
  location          String?
  notes             String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  @@index([account_id])
  @@index([contact_id])
  @@index([lead_event_id])
  @@index([start_time])
}

model QuoteRequest {
  id               String      @id @default(cuid())
  account_id       String
  contact_id       String
  lead_event_id    String?
  service_type     String
  description      String?
  photos           String[]
  property_address String?
  estimated_value  Int?
  status           QuoteStatus @default(requested)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([account_id])
  @@index([contact_id])
}

model Automation {
  id                String                @id @default(cuid())
  account_id        String
  name              String
  trigger_type      AutomationTriggerType
  status            AutomationStatus      @default(draft)
  workflow_provider WorkflowProvider
  webhook_url       String?
  config_json       Json
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt

  @@index([account_id])
  @@index([trigger_type])
}

model Notification {
  id            String              @id @default(cuid())
  account_id    String
  lead_event_id String?
  channel       NotificationChannel
  recipient     String
  subject       String?
  message       String
  status        NotificationStatus  @default(queued)
  sent_at       DateTime?
  created_at    DateTime            @default(now())

  @@index([account_id])
  @@index([lead_event_id])
}

model RevenueMetrics {
  id                          String   @id @default(cuid())
  account_id                  String
  period_start                DateTime
  period_end                  DateTime
  total_calls                 Int      @default(0)
  missed_calls                Int      @default(0)
  calls_answered_by_ai        Int      @default(0)
  qualified_leads             Int      @default(0)
  appointments_booked         Int      @default(0)
  quotes_requested            Int      @default(0)
  quotes_sent                 Int      @default(0)
  jobs_won                    Int      @default(0)
  estimated_recovered_revenue Int      @default(0)
  verified_recovered_revenue  Int      @default(0)
  admin_hours_saved           Int      @default(0)
  response_time_avg_seconds   Int      @default(0)
  roi_multiple                Float?
  created_at                  DateTime @default(now())

  @@unique([account_id, period_start, period_end])
  @@index([account_id])
}

// --- v0.2 additions (docs/v0.2-implementation-spec.md §2) -------------------


  recovery_pro
  recovery_performance
}

enum EngagementStatus {
  active
  paused
  cancelled
  completed
}

enum OutcomeFeeKind {
  per_qualified_appointment
  per_verified_recovered_lead
  pct_recovered_revenue
  threshold_bonus
}

enum UsageModel {
  bundled_with_cap
  passthrough_with_margin
}

enum ActorType {
  user
  system
  webhook
}

enum WebhookProcessStatus {
  received
  processed
  rejected
  duplicate
  error
}

enum ProspectIntakeStatus {
  received
  reviewed
  qualified
  rejected
}

enum ProspectNotificationStatus {

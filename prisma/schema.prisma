// --- v0.2 closeout step 2.3, PR 31D — audit_logs expansion ----------------
//
// Adds the `AuditCategory` enum and the six new nullable columns
// (actor_role, category, reason, before_ref, after_ref, expires_at)
// to the existing AuditLog model. Everything additive; no existing
// row needs migration. See ADR-0019 step 2.3 + planning artifact §4
// + RESPONSEOS_EVENT_SCHEMA.md §7.
enum AuditCategory {
  security
  data_access
  break_glass
  integration
  workflow
  system
}

model AssessmentReport {
  id         String           @id @default(cuid())
  account_id String
  status     AssessmentStatus @default(draft)

  inputs_json Json

  readiness_score          Int?
  revenue_leak_estimate    Int?
  fit_diagnosis            FitDiagnosis?
  current_workflow_map     Json?
  recommended_workflow_map Json?
  implementation_scope     String?
  projected_roi_multiple   Float?

  proposed_tier          EngagementTier?
  proposed_setup_cents   Int?
  proposed_monthly_cents Int?
  proposed_outcome_terms Json?

  delivered_at DateTime?
  signed_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([account_id])
  @@index([status])
  @@index([created_at])
}

model Engagement {
  id                   String @id @default(cuid())
  account_id           String
  assessment_report_id String @unique

  tier   EngagementTier
  status EngagementStatus @default(active)

  setup_fee_cents        Int
  monthly_fee_cents      Int
  outcome_fee_kind       OutcomeFeeKind?
  outcome_fee_terms_json Json?

  usage_model            UsageModel
  included_voice_minutes Int?
  passthrough_margin_pct Int?

  is_founding_pilot Boolean   @default(false)
  pilot_ends_at     DateTime?

  signed_at  DateTime
  started_at DateTime?
  ended_at   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([account_id])
  @@index([status])
  @@index([signed_at])
}

model AuditLog {
  id            String         @id @default(cuid())
  account_id    String?
  actor_user_id String?
  actor_type    ActorType
  // 31D additions — all nullable so existing seeded rows stay valid
  // without backfill. `category` enables the break-glass filter that
  // the future privileged raw-transcript read accessor will write
  // against (see RESPONSEOS_DATA_MODEL.md §6 + planning artifact Q7).
  actor_role    UserRole?
  action        String
  category      AuditCategory?
  target_type   String?
  target_id     String?
  reason        String?
  before_ref    Json?
  after_ref     Json?
  expires_at    DateTime?
  metadata_json Json?
  ip_address    String?
  user_agent    String?
  created_at    DateTime       @default(now())

  @@index([account_id])
  @@index([actor_user_id])
  @@index([action])
  @@index([category])
  @@index([created_at])
}

model WebhookEvent {
  id                 String               @id @default(cuid())
  account_id         String?
  provider           String
  provider_event_id  String
  event_type         String
  raw_body           String
  signature_header   String?
  signature_valid    Boolean              @default(false)
  dedupe_hash        String               @unique
  received_at        DateTime             @default(now())
  processed_at       DateTime?
  process_status     WebhookProcessStatus @default(received)
  process_error      String?
  payload_expires_at DateTime?
  payload_purged_at  DateTime?

  @@unique([provider, provider_event_id])
  @@index([account_id])
  @@index([provider])
  @@index([received_at])
  @@index([process_status])
  @@index([payload_expires_at])
}

model ProspectIntake {
  id                  String                     @id @default(cuid())
  account_id          String
  reference           String                     @unique
  idempotency_key     String
  payload_hash        String
  request_json        Json?
  status              ProspectIntakeStatus       @default(received)
  notification_status ProspectNotificationStatus @default(pending)
  notification_error  String?
  reviewed_by         String?
  reviewed_at         DateTime?
  expires_at          DateTime
  purged_at           DateTime?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  @@unique([account_id, idempotency_key])
  @@index([account_id, status])
  @@index([expires_at])
  @@index([created_at])
}

model CrmSyncOperation {
  id                   String                 @id @default(cuid())
  account_id           String
  operation_key        String                 @unique
  provider             String
  call_id              String
  source_webhook_id    String?
  status               CrmSyncOperationStatus @default(pending)
  attempt_count        Int                    @default(0)
  provider_contact_id  String?
  provider_activity_id String?
  provider_task_id     String?
  last_error_code      String?
  last_error_redacted  String?
  next_attempt_at      DateTime?
  completed_at         DateTime?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  @@index([account_id, status])
  @@index([call_id])
  @@index([source_webhook_id])
}

// --- Personalized prospect bootstrap (ADR-0048) ---------------------------
//
// A prospect bootstrap is an operator-only, sandbox-tenant workflow. Public
// source content is never treated as owner-confirmed truth, approved snapshots
// are immutable, and number routing is resolved from temporal assignments.

model ProspectBootstrap {
  id                         String                  @id @default(cuid())
  account_id                 String
  prospect_intake_id         String?
  canonical_website          String
  status                     ProspectBootstrapStatus @default(draft)
  active_account_key         String?                 @unique
  current_memory_snapshot_id String?
  active_assignment_id       String?
  approved_by                String?
  approved_at                DateTime?
  activated_at               DateTime?
  completed_at               DateTime?
  converted_at               DateTime?
  review_expires_at          DateTime?
  expires_at                 DateTime?
  content_expires_at         DateTime?
  content_purged_at          DateTime?
  cleanup_completed_at       DateTime?
  promotion_correlation_id   String?
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt

  @@index([account_id, status])
  @@index([review_expires_at])
  @@index([expires_at])
  @@index([content_expires_at])
  @@index([created_at])
}

model KnowledgeIngestionRun {
  id                String                   @id @default(cuid())
  account_id        String
  bootstrap_id      String
  status            KnowledgeIngestionStatus @default(pending)
  extractor_version String
  template_version  String
  source_count      Int                      @default(0)
  fact_count        Int                      @default(0)
  conflict_count    Int                      @default(0)
  error_code        String?
  error_redacted    String?
  started_at        DateTime?
  ended_at          DateTime?
  created_at        DateTime                 @default(now())

  @@index([account_id, bootstrap_id])
  @@index([status, created_at])
}

model KnowledgeSource {
  id               String                @id @default(cuid())
  account_id       String
  bootstrap_id     String
  ingestion_run_id String?
  source_type      KnowledgeSourceType
  url              String
  normalized_url   String
  status           KnowledgeSourceStatus @default(pending)
  robots_decision  String?
  http_status      Int?
  content_type     String?
  content_hash     String?
  extracted_text   String?
  fetched_at       DateTime?
  expires_at       DateTime?
  purged_at        DateTime?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  @@unique([bootstrap_id, normalized_url])
  @@index([account_id, bootstrap_id])
  @@index([expires_at])
}

model KnowledgeFact {
  id                   String              @id @default(cuid())
  account_id           String
  bootstrap_id         String
  source_id            String
  source_ids_json      Json
  source_evidence_json Json?
  fact_key             String
  value_json           Json
  evidence_excerpt     String
  status               KnowledgeFactStatus @default(source_observed)
  confidence           Float?
  conflict_group       String?
  valid_as_of          DateTime?
  reviewed_by          String?
  reviewed_at          DateTime?
  expires_at           DateTime?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  @@index([account_id, bootstrap_id])
  @@index([source_id])
  @@index([fact_key, status])
}

model BusinessMemorySnapshot {
  id                       String                       @id @default(cuid())
  account_id               String
  bootstrap_id             String?
  promotion_correlation_id String?                      @unique
  schema_version           String
  version                  Int
  memory_json              Json
  content_hash             String
  template_version         String
  status                   BusinessMemorySnapshotStatus @default(draft)
  approved_by              String?
  approved_at              DateTime?
  revoked_at               DateTime?
  created_at               DateTime                     @default(now())

  @@unique([bootstrap_id, version])
  @@unique([bootstrap_id, content_hash])
  @@index([account_id, bootstrap_id, status])
}

model TelephonyNumber {
  id                    String                @id @default(cuid())
  provider              String
  provider_number_id    String
  e164                  String
  capabilities_json     Json?
  status                TelephonyNumberStatus @default(available)
  monthly_cost_micros   Int?
  deletion_lock_enabled Boolean               @default(true)
  evergreen             Boolean               @default(false)
  acquired_at           DateTime?
  released_at           DateTime?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  @@unique([provider, provider_number_id])
  @@unique([provider, e164])
  @@index([status])
}

model TelephonyNumberAssignment {
  id                        String                          @id @default(cuid())
  account_id                String
  bootstrap_id              String
  telephony_number_id       String
  provider_assistant_id     String
  status                    TelephonyNumberAssignmentStatus @default(assigned)
  number_exclusivity_key    String?                         @unique
  bootstrap_exclusivity_key String?                         @unique
  assigned_at               DateTime                        @default(now())
  activated_at              DateTime?
  unassigned_at             DateTime?
  quarantine_until          DateTime?
  last_inbound_at           DateTime?
  created_at                DateTime                        @default(now())
  updated_at                DateTime                        @updatedAt

  @@index([account_id, bootstrap_id])
  @@index([telephony_number_id, assigned_at, unassigned_at], map: "TelephonyNumberAssignment_number_history_idx")
  @@index([status, quarantine_until])
}

model BootstrapPromotion {
  id                   String                   @id @default(cuid())
  account_id           String
  bootstrap_id         String
  correlation_id       String                   @unique
  source_snapshot_id   String
  source_snapshot_hash String
  manifest_json        Json
  manifest_hash        String
  status               BootstrapPromotionStatus @default(draft)
  exported_by          String?
  exported_at          DateTime?
  imported_account_ref String?
  imported_at          DateTime?
  cancelled_at         DateTime?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  @@index([account_id, bootstrap_id])
  @@index([status, created_at])
}

// --- v0.2 closeout step 2.3, PR 31A — communication substrate -------------

enum ProviderConnectionProvider {
  twilio
  grok
  openai
  retell
  vapi
  bland
  hubspot
  google_calendar
  calcom
  stripe
  telnyx
  calendly
}

enum ProviderConnectionStatus {
  connected
  disconnected
  error
  expired
}

enum ConversationStatus {
  open
  archived
  blocked
  spam
}

enum SmsProvider {
  twilio
  manual
  telnyx
}

enum SmsDirection {
  inbound
  outbound
}

enum SmsMessageStatus {
  queued
  sending
  sent
  delivered
  failed
  received
}

model ProviderConnection {
  id                            String                     @id @default(cuid())
  account_id                    String
  provider                      ProviderConnectionProvider
  // Opaque AES-256-GCM ciphertext with envelope framing per ADR-0020:
  //   [version: u8 | algorithm: u8 | nonce: 12 bytes | ciphertext+tag]
  // Never logged; never returned as JSON. Decryption happens in
  // lib/providers/encryption/* at the adapter boundary, never in
  // lib/data/* accessors.
  credentials_encrypted         Bytes
  oauth_refresh_token_encrypted Bytes?
  status                        ProviderConnectionStatus   @default(connected)
  scopes                        String[]
  connected_by                  String
  last_verified_at              DateTime?
  created_at                    DateTime                   @default(now())
  updated_at                    DateTime                   @updatedAt

  @@unique([account_id, provider])
  @@index([account_id])
  @@index([status])
}

model Conversation {
  id              String             @id @default(cuid())
  account_id      String
  contact_id      String?
  business_number String
  peer_number     String
  status          ConversationStatus @default(open)
  last_message_at DateTime
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  @@unique([account_id, business_number, peer_number])
  @@index([account_id])
  @@index([contact_id])
  @@index([last_message_at])
}

model SmsMessage {
  id                  String           @id @default(cuid())
  account_id          String
  conversation_id     String
  provider            SmsProvider
  provider_message_id String?
  direction           SmsDirection
  from_number         String
  to_number           String
  body                String
  status              SmsMessageStatus
  segment_count       Int              @default(1)
  error_code          String?
  error_message       String?
  sent_at             DateTime?
  delivered_at        DateTime?
  created_at          DateTime         @default(now())

  @@unique([provider, provider_message_id])
  @@index([account_id])
  @@index([conversation_id])
  @@index([created_at])
}

// --- v0.2 closeout step 2.3, PR 31B — call intelligence substrate ---------

enum CallSegmentSpeaker {
  caller
  agent
  system
}

enum TranscriptRetentionLane {
  full
  redacted_only
  metadata_only
}

enum QaReviewerType {
  human
  system
  automated_llm
}

model CallSegment {
  id            String             @id @default(cuid())
  account_id    String
  call_id       String
  sequence      Int
  speaker       CallSegmentSpeaker
  text          String
  redacted_text String?
  confidence    Float?
  started_at    DateTime
  ended_at      DateTime
  created_at    DateTime           @default(now())

  @@unique([call_id, sequence])
  @@index([account_id])
  @@index([call_id])
  @@index([created_at])
}

model CallTranscript {
  // Object-storage refs `raw_ref` and `redacted_ref` are columns on this
  // model but they are NOT exposed by the lib/data/* accessor in v0.2.
  // Privileged raw-transcript read lands after 31D ships
  // `audit_logs.category = "break_glass"` so every elevated read is
  // recorded. See ADR-0019 step 2.3 + planning artifact Q7.
  id             String                  @id @default(cuid())
  account_id     String
  call_id        String                  @unique
  raw_ref        String?
  redacted_ref   String?
  inline_text    String?
  language       String                  @default("en")
  retention_lane TranscriptRetentionLane @default(full)
  expires_at     DateTime?
  redacted_at    DateTime?
  created_at     DateTime                @default(now())

  @@index([account_id])
  @@index([expires_at])
}

model QaLog {
  id               String         @id @default(cuid())
  account_id       String
  call_id          String
  rubric_version   String
  reviewer_type    QaReviewerType
  reviewer_user_id String?
  score            Int?
  findings_json    Json
  notes            String?
  reviewed_at      DateTime
  created_at       DateTime       @default(now())

  @@index([account_id])
  @@index([call_id])
  @@index([reviewed_at])
}

// --- v0.2 closeout step 2.3, PR 31C — workflow execution substrate --------

enum WorkflowRunStatus {
  started
  completed
  failed
  cancelled
  dead_letter
}

model WorkflowRun {
  id               String            @id @default(cuid())
  account_id       String
  // Provider-stable idempotency / dedupe spine per
  // RESPONSEOS_EVENT_SCHEMA.md §4. A replay of the same `workflow_run_id`
  // is a no-op on the writer, not a duplicate row.
  workflow_run_id  String            @unique
  // Workflow definition label (e.g. `missed_call_recovery`). Not a FK
  // in v0.2 — workflow definitions live in n8n / Git, not in
  // ResponseOS. See ADR-0017 and planning artifact Q11.
  workflow_id      String
  // Reuses the existing `WorkflowProvider` enum (n8n / make / internal)
  // per planning artifact Q12 — the semantic set already matches.
  provider         WorkflowProvider
  // Forward-compat hook for a future link into the events ledger; held
  // as a string today (no FK enforced) so the substrate is ready
  // without coupling to ledger persistence.
  trigger_event_id String?
  status           WorkflowRunStatus @default(started)
  started_at       DateTime
  ended_at         DateTime?
  error_message    String?
  payload_json     Json?
  created_at       DateTime          @default(now())

  @@index([account_id])
  @@index([workflow_id])
  @@index([status])
  @@index([started_at])
}

// --- Internal demo professional receptionist (ADR-0046) -------------------
//
// Substrate for the ResponseOS reference tenant: which agent profile
// answers, and the structured professional opportunity a recruiter or
// prospect interaction produces. Both tables are ordinary per-tenant
// tables — `account_id` scoping, no relations (matching the rest of
// this schema), no FK constraints, and no privileged read path.

enum AgentProfileType {
  recruiter_receptionist
  consulting_receptionist
  professional_assistant
  demo_mode
}

enum ProfessionalOpportunityType {
  employment
  contract
  consulting
  partnership
  media
}

enum ProfessionalOpportunityStatus {
  new
  qualifying
  scheduled
  escalated
  closed
}

enum ProfessionalInterestLevel {
  low
  medium
  high
}

model AgentProfile {
  id                 String           @id @default(cuid())
  account_id         String
  name               String
  slug               String
  type               AgentProfileType
  enabled            Boolean          @default(true)
  // The profile the receptionist answers with when the caller has not
  // selected one. The resolver falls back to the first enabled profile
  // when no row is marked.
  is_default         Boolean          @default(false)
  // Per-profile disclosure and capability policy — compensation and
  // reference disclosure, allowed appointment types, allowed asset
  // types, knowledge fallback mode. Parsed as `AgentProfilePolicy`
  // in lib/professional/policy.ts.
  system_policy_json Json?
  metadata_json      Json?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  @@unique([account_id, slug])
  @@index([account_id])
}

model ProfessionalOpportunity {
  id               String  @id @default(cuid())
  account_id       String
  contact_id       String?
  // Which agent profile handled the interaction that produced this row.
  agent_profile_id String?

  opportunity_type ProfessionalOpportunityType
  company          String?
  role_title       String?
  recruiter_name   String?
  recruiter_email  String?
  recruiter_phone  String?

  interest_level ProfessionalInterestLevel?
  status         ProfessionalOpportunityStatus @default(new)

  // Interaction provenance. Both channels are carried because the
  // receptionist is reachable by voice (Call) and by messaging
  // (Conversation).
  source_call_id         String?
  source_conversation_id String?
  appointment_id         String?

  questions_asked         Json?
  summary                 String?
  recommended_preparation Json?
  next_action             String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([account_id])
  @@index([account_id, status])
  @@index([created_at])
}

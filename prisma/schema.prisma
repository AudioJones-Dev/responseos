// ResponseOS — schema for v0.2.
// v0.1 baseline: 11 TypeScript models in /types mirrored as Prisma models.
// v0.2 delta: adds 4 new models (AssessmentReport, Engagement, AuditLog, WebhookEvent)
// + 4 new enum families per docs/v0.2-implementation-spec.md §2.
// Existing v0.1 models and enums are preserved unchanged.
//
// Conventions:
// - snake_case columns to match the API/JSON shapes already used by the app.
// - Tenant isolation: every per-tenant table carries account_id.
// - Money is stored in cents (Int).
// - JSON fields use the database Json type so config payloads stay flexible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Use DIRECT_URL when running migrations through a non-pooled connection.
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  lead
  active
  paused
  cancelled
}

enum UserRole {
  aj_admin
  operator
  client_admin
  client_viewer
}

enum ContactSource {
  call
  sms
  form
  manual
  crm_sync
}

enum CallProvider {
  twilio
  retell
  vapi
  bland
  manual
}

enum CallDirection {
  inbound
  outbound
}

enum CallStatus {
  answered
  missed
  voicemail
  spam
  failed
  completed
}

enum CallSentiment {
  positive
  neutral
  negative
}

enum LeadEventSource {
  phone
  sms
  website
  manual
  outbound
}

enum LeadEventType {
  missed_call
  answered_call
  quote_request
  booking_request
  qualified_lead
  spam
  follow_up_needed
  appointment_booked
  quote_sent
  job_won
  job_lost
}

enum LeadEventStatus {
  new
  qualified
  unqualified
  booked
  quoted
  won
  lost
  archived
}

enum LeadUrgency {
  low
  medium
  high
}

enum QualificationTimeline {
  same_day
  this_week
  this_month
  unknown
}

enum QualificationStatus {
  qualified
  maybe
  unqualified
  spam
}

enum CalendarProvider {
  google
  calcom
  ghl
  manual
}

enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum QuoteStatus {
  requested
  reviewing
  sent
  accepted
  declined
}

enum AutomationTriggerType {
  missed_call
  after_hours_call
  new_lead
  quote_requested
  booking_created
  no_response
  job_completed
}

enum AutomationStatus {
  active
  paused
  draft
}

enum WorkflowProvider {
  n8n
  make
  internal
}

enum NotificationChannel {
  sms
  email
  in_app
  slack
}

enum NotificationStatus {
  queued
  sent
  failed
}

model Account {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  industry      String
  website_url   String?
  primary_phone String?
  timezone      String
  status        AccountStatus @default(lead)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
}

model User {
  id              String   @id @default(cuid())
  account_id String?
  role            UserRole
  name            String
  email           String   @unique
  phone           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([account_id])
}

model Contact {
  id              String        @id @default(cuid())
  account_id String
  first_name      String?
  last_name       String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  source          ContactSource
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@index([account_id])
  @@index([phone])
  @@index([email])
}

model Call {
  id               String         @id @default(cuid())
  account_id  String
  contact_id       String?
  provider         CallProvider
  provider_call_id String?
  direction        CallDirection
  status           CallStatus
  from_number      String
  to_number        String
  started_at       DateTime
  ended_at         DateTime?
  duration_seconds Int?
  recording_url    String?
  transcript       String?
  summary          String?
  sentiment        CallSentiment?
  spam_score       Float?
  lead_score       Int?
  created_at       DateTime       @default(now())

  @@index([account_id])
  @@index([contact_id])
  @@index([started_at])
}

model LeadEvent {
  id              String          @id @default(cuid())
  account_id String
  contact_id      String?
  call_id         String?
  source          LeadEventSource
  event_type      LeadEventType
  status          LeadEventStatus @default(new)
  urgency         LeadUrgency     @default(medium)
  estimated_value Int?
  recovered_value Int?
  notes           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  @@index([account_id])
  @@index([contact_id])
  @@index([call_id])
  @@index([status])
}

model LeadQualification {
  id                      String                 @id @default(cuid())
  lead_event_id           String                 @unique
  service_needed          String?
  service_area_match      Boolean
  budget_range            String?
  timeline                QualificationTimeline?
  property_type           String?
  decision_maker          Boolean?
  qualification_score     Int
  qualification_status    QualificationStatus
  disqualification_reason String?
  created_at              DateTime               @default(now())
}

model Appointment {
  id                String           @id @default(cuid())
  account_id   String
  contact_id        String
  lead_event_id     String?
  calendar_provider CalendarProvider
  external_event_id String?
  title             String
  start_time        DateTime
  end_time          DateTime
  status            AppointmentStatus    @default(scheduled)
  location          String?
  notes             String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@index([account_id])
  @@index([contact_id])
  @@index([lead_event_id])
  @@index([start_time])
}

model QuoteRequest {
  id               String      @id @default(cuid())
  account_id  String
  contact_id       String
  lead_event_id    String?
  service_type     String
  description      String?
  photos           String[]
  property_address String?
  estimated_value  Int?
  status           QuoteStatus @default(requested)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([account_id])
  @@index([contact_id])
}

model Automation {
  id                String                @id @default(cuid())
  account_id   String
  name              String
  trigger_type      AutomationTriggerType
  status            AutomationStatus      @default(draft)
  workflow_provider WorkflowProvider
  webhook_url       String?
  config_json       Json
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt

  @@index([account_id])
  @@index([trigger_type])
}

model Notification {
  id              String              @id @default(cuid())
  account_id String
  lead_event_id   String?
  channel         NotificationChannel
  recipient       String
  subject         String?
  message         String
  status          NotificationStatus  @default(queued)
  sent_at         DateTime?
  created_at      DateTime            @default(now())

  @@index([account_id])
  @@index([lead_event_id])
}

model RevenueMetrics {
  id                          String   @id @default(cuid())
  account_id             String
  period_start                DateTime
  period_end                  DateTime
  total_calls                 Int      @default(0)
  missed_calls                Int      @default(0)
  calls_answered_by_ai        Int      @default(0)
  qualified_leads             Int      @default(0)
  appointments_booked         Int      @default(0)
  quotes_requested            Int      @default(0)
  quotes_sent                 Int      @default(0)
  jobs_won                    Int      @default(0)
  estimated_recovered_revenue Int      @default(0)
  verified_recovered_revenue  Int      @default(0)
  admin_hours_saved           Int      @default(0)
  response_time_avg_seconds   Int      @default(0)
  roi_multiple                Float?
  created_at                  DateTime @default(now())

  @@unique([account_id, period_start, period_end])
  @@index([account_id])
}

// --- v0.2 additions (docs/v0.2-implementation-spec.md §2) -------------------

enum AssessmentStatus {
  draft
  in_review
  delivered
  signed
  declined
  expired
}

enum FitDiagnosis {
  ai_fit
  borderline
  no_fit
}

enum EngagementTier {
  recovery_core
  recovery_pro
  recovery_performance
}

enum EngagementStatus {
  active
  paused
  cancelled
  completed
}

enum OutcomeFeeKind {
  per_qualified_appointment
  per_verified_recovered_lead
  pct_recovered_revenue
  threshold_bonus
}

enum UsageModel {
  bundled_with_cap
  passthrough_with_margin
}

enum ActorType {
  user
  system
  webhook
}

enum WebhookProcessStatus {
  received
  processed
  rejected
  duplicate
  error
}

model AssessmentReport {
  id              String           @id @default(cuid())
  account_id String
  status          AssessmentStatus @default(draft)

  inputs_json Json

  readiness_score          Int?
  revenue_leak_estimate    Int?
  fit_diagnosis            FitDiagnosis?
  current_workflow_map     Json?
  recommended_workflow_map Json?
  implementation_scope     String?
  projected_roi_multiple   Float?

  proposed_tier          EngagementTier?
  proposed_setup_cents   Int?
  proposed_monthly_cents Int?
  proposed_outcome_terms Json?

  delivered_at DateTime?
  signed_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([account_id])
  @@index([status])
  @@index([created_at])
}

model Engagement {
  id                   String @id @default(cuid())
  account_id      String
  assessment_report_id String @unique

  tier   EngagementTier
  status EngagementStatus @default(active)

  setup_fee_cents        Int
  monthly_fee_cents      Int
  outcome_fee_kind       OutcomeFeeKind?
  outcome_fee_terms_json Json?

  usage_model            UsageModel
  included_voice_minutes Int?
  passthrough_margin_pct Int?

  is_founding_pilot Boolean   @default(false)
  pilot_ends_at     DateTime?

  signed_at  DateTime
  started_at DateTime?
  ended_at   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([account_id])
  @@index([status])
  @@index([signed_at])
}

model AuditLog {
  id              String    @id @default(cuid())
  account_id String?
  actor_user_id   String?
  actor_type      ActorType
  action          String
  target_type     String?
  target_id       String?
  metadata_json   Json?
  ip_address      String?
  user_agent      String?
  created_at      DateTime  @default(now())

  @@index([account_id])
  @@index([actor_user_id])
  @@index([action])
  @@index([created_at])
}

model WebhookEvent {
  id                String               @id @default(cuid())
  account_id   String?
  provider          String
  provider_event_id String
  event_type        String
  raw_body          String
  signature_header  String?
  signature_valid   Boolean              @default(false)
  dedupe_hash       String               @unique
  received_at       DateTime             @default(now())
  processed_at      DateTime?
  process_status    WebhookProcessStatus @default(received)
  process_error     String?

  @@index([account_id])
  @@index([provider])
  @@index([received_at])
  @@index([process_status])
}

// --- v0.2 closeout step 2.3, PR 31A — communication substrate -------------

enum ProviderConnectionProvider {
  twilio
  grok
  openai
  retell
  vapi
  bland
  hubspot
  google_calendar
  calcom
  stripe
}

enum ProviderConnectionStatus {
  connected
  disconnected
  error
  expired
}

enum ConversationStatus {
  open
  archived
  blocked
  spam
}

enum SmsProvider {
  twilio
  manual
}

enum SmsDirection {
  inbound
  outbound
}

enum SmsMessageStatus {
  queued
  sending
  sent
  delivered
  failed
  received
}

model ProviderConnection {
  id                              String                     @id @default(cuid())
  account_id                      String
  provider                        ProviderConnectionProvider
  // Opaque AES-256-GCM ciphertext with envelope framing per ADR-0020:
  //   [version: u8 | algorithm: u8 | nonce: 12 bytes | ciphertext+tag]
  // Never logged; never returned as JSON. Decryption happens in
  // lib/providers/encryption/* at the adapter boundary, never in
  // lib/data/* accessors.
  credentials_encrypted           Bytes
  oauth_refresh_token_encrypted   Bytes?
  status                          ProviderConnectionStatus   @default(connected)
  scopes                          String[]
  connected_by                    String
  last_verified_at                DateTime?
  created_at                      DateTime                   @default(now())
  updated_at                      DateTime                   @updatedAt

  @@unique([account_id, provider])
  @@index([account_id])
  @@index([status])
}

model Conversation {
  id              String             @id @default(cuid())
  account_id      String
  contact_id      String?
  business_number String
  peer_number     String
  status          ConversationStatus @default(open)
  last_message_at DateTime
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  @@unique([account_id, business_number, peer_number])
  @@index([account_id])
  @@index([contact_id])
  @@index([last_message_at])
}

model SmsMessage {
  id                  String           @id @default(cuid())
  account_id          String
  conversation_id     String
  provider            SmsProvider
  provider_message_id String?
  direction           SmsDirection
  from_number         String
  to_number           String
  body                String
  status              SmsMessageStatus
  segment_count       Int              @default(1)
  error_code          String?
  error_message       String?
  sent_at             DateTime?
  delivered_at        DateTime?
  created_at          DateTime         @default(now())

  @@unique([provider, provider_message_id])
  @@index([account_id])
  @@index([conversation_id])
  @@index([created_at])
}

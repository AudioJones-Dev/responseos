  sent
  failed
}

enum CrmSyncOperationStatus {
  pending
  processing
  succeeded
  retryable_failed
  review_required
  cancelled
}

enum ProspectBootstrapStatus {
  draft
  ingesting
  review_required
  approved
  provisioning
  ready
  active
  completed
  promotion_pending
  converted
  expired
  cleanup_pending
  cleaned
  failed
}

enum KnowledgeIngestionStatus {
  pending
  running
  completed
  failed
}

enum KnowledgeSourceType {
  website_page
  manual_reference
}

enum KnowledgeSourceStatus {
  pending
  acquired
  blocked
  failed

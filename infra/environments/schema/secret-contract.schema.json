{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://responseos.dev/schemas/secret-contract.v1.json",
  "title": "ResponseOS Secret Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "environment", "variables"],
  "properties": {
    "schemaVersion": { "const": "responseos.secret-contract.v1" },
    "contractVersion": { "const": "1.0.0" },
    "environment": { "type": "string", "minLength": 1 },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variable" }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification",
        "required",
        "scope",
        "environment",
        "providerOwner",
        "serverOnly",
        "clientExposed",
        "transferableValue",
        "independentProductionValueRequired",
        "rotationRequired",
        "activationEffect",
        "notes"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "classification": {
          "enum": ["credential", "webhook-secret", "connection-credential", "public-identifier", "configuration", "control-secret"]
        },
        "required": { "type": "boolean" },
        "scope": { "enum": ["application-runtime", "ci-workflow-control"] },
        "environment": { "type": "string", "minLength": 1 },
        "providerOwner": { "type": "string", "minLength": 1 },
        "serverOnly": { "type": "boolean" },
        "clientExposed": { "type": "boolean" },
        "transferableValue": { "const": false },
        "independentProductionValueRequired": { "type": "boolean" },
        "rotationRequired": { "type": "boolean" },
        "activationEffect": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
